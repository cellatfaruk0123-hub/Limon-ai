# Bu dosyayı .env adıyla kopyalayıp doldurun. .env dosyasını kimseyle paylaşmayın.
# Render'da Environment bölümüne de aynı adlarla yazılır.
# Resimle arama (SerpApi ücretsiz plan).
SERPAPI_KEY=
# Fotoğraf yorumu ve karar (Google AI Studio ücretsiz anahtar).
GEMINI_API_KEY=
# İsteğe bağlı: Gemini model adı (boşsa program sırayla dener)
GEMINI_MODEL=
# İsteğe bağlı: program şifresi. Boşsa şifresiz çalışır.
APP_PIN=
