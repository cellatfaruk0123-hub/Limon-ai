# Bu dosyayı .env adıyla kopyalayıp doldurun. .env dosyasını kimseyle paylaşmayın.
# İleride bağlanacak ücretsiz servis anahtarları (şimdilik boş kalabilir):
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
# Resimle arama (SerpApi ücretsiz plan). Render'da Environment bölümüne de aynı adla yazılır.
SERPAPI_KEY=
# Fotoğraf yorumu ve karar (Google AI Studio ücretsiz anahtar). Render'da Environment'a da yazılır.
GEMINI_API_KEY=
# İsteğe bağlı: Gemini model adı (boşsa program sırayla dener)
GEMINI_MODEL=
